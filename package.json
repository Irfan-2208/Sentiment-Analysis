{
  "name": "social-pulse",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "lint": "npm run lint --workspace=shared --workspace=server --workspace=client",
    "typecheck": "npm run typecheck --workspace=shared --workspace=server --workspace=client",
    "test": "npm run test --workspace=shared --workspace=server",
    "eval": "npm run eval --workspace=server",
    "nlp:dev": "python -m uvicorn main:app --app-dir nlp-service --reload --port 8000",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.3.3"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100,
    "tabWidth": 2
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
