# ─────────────────────────────────────────────────────────────
# Social Pulse — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=4000

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/socialpulse

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173

# ── YouTube Data API v3 ──────────────────────────────────────
# Leave empty to run in DEMO_MODE automatically
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# ── AI Provider ──────────────────────────────────────────────
# Options: gemini | openai | local
# "local" uses the built-in rule-based analyzer (no API key needed)
AI_PROVIDER=gemini

# ── Google Gemini ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Current model — see https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.0-flash

# ── OpenAI (optional) ────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Demo Mode ────────────────────────────────────────────────
# Set to "true" to always use fixture comments (no YouTube key needed).
# Automatically set to "true" when YOUTUBE_API_KEY is empty.
DEMO_MODE=

# ── Pipeline Tuning ──────────────────────────────────────────
# Number of comments per LLM batch (default 25)
BATCH_SIZE=25
# Max concurrent LLM batch requests (default 3)
AI_CONCURRENCY=3
# Hard cap on comments fetched per analysis (default 1000)
MAX_COMMENTS_LIMIT=100000

# ── Logging ──────────────────────────────────────────────────
# Levels: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
